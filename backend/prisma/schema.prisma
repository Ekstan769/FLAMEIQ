// GasPoint / FlameIQ Prisma schema
// Covers authentication, profile management, reminders, and support.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TxType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  REFUND
}

enum TxStatus {
  PENDING
  SUCCESS
  FAILED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  ON_ROUTE
  DELIVERED
  REJECTED
  CANCELLED
}

enum OrderType {
  STANDARD
  QUICK
}

enum Role {
  USER
  ADMIN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ProfileType {
  USER
  VENDOR
  ADMIN
}

enum CylinderSize {
  KG_3
  KG_6
  KG_12
  KG_12_5
  KG_25
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id        String     @id @default(uuid()) // Changed to UUID
  name      String
  email     String     @unique
  password  String
  riskLevel RiskLevel?
  role      Role       @default(USER)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  profile          Profile?
  notifications    Notification[] // The relation name on the User model should be plural
  gasPredictions   GasPrediction[]
  supportTickets   SupportTicket[]
  loginHistories   LoginHistory[]
  transactions     Transaction[]
  otpVerifications OtpVerification[]
  authoredReviews  Review[]          @relation("AuthoredReviews")
  receivedReviews  Review[]          @relation("ReceivedReviews")
  orders           Order[]           @relation("UserOrders") // Added for Order.user relation
  vendorOrders     Order[]           @relation("VendorOrders") // Added for Order.vendor relation
  cylinders        Cylinder[]

  @@index([email])
}

model Profile {
  id           String      @id @default(uuid()) // Changed to UUID
  userId       String      @unique // Changed to String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileType  ProfileType @default(USER)
  businessName String?
  phone        String?
  profilePic   String?
  address      String?
  latitude     Float?
  longitude    Float?
  isVerified   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
}

// - OTP Verification -
model OtpVerification {
  id        Int       @id @default(autoincrement())
  userId    String // Changed to String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade) // Added onDelete: Cascade
  codeHash  String
  purpose   String // "REGISTRATION", "LOGIN", "PASSWORD_RESET"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Cylinder {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  size         CylinderSize
  serialNumber String?      @unique
  nickname     String?
  lastRefill   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  orders         Order[]
  gasPredictions GasPrediction[]
}

model GasPrediction {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cylinderId         String?
  cylinder           Cylinder? @relation(fields: [cylinderId], references: [id], onDelete: SetNull)
  estimatedEmptyDate DateTime
  confidence         Float?
  createdAt          DateTime  @default(now())

  @@index([userId])
  @@index([cylinderId])
}

model Notification {
  id        String   @id @default(uuid()) // Changed to UUID
  userId    String // Changed to String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model SupportTicket {
  id        String       @id @default(uuid()) // Changed to UUID
  userId    String // Changed to String
  user      User         @relation(fields: [userId], references: [id])
  subject   String
  message   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())

  @@index([userId])
}

model LoginHistory {
  id        String   @id @default(uuid()) // Changed to UUID
  userId    String // Changed to String
  user      User     @relation(fields: [userId], references: [id])
  ipAddress String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Transaction {
  orderId     String?  @unique
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  id          String   @id @default(uuid()) // Changed to UUID
  amount      Decimal
  type        TxType
  status      TxStatus
  reference   String   @unique
  description String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId      String? // Changed to String

  @@index([userId])
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation("UserOrders", fields: [userId], references: [id], onDelete: Cascade) // Added relation name
  vendorId    String // This should relate to a User with the VENDOR role
  vendor      User        @relation("VendorOrders", fields: [vendorId], references: [id], onDelete: NoAction)
  status      OrderStatus @default(PENDING)
  type        OrderType
  totalAmount Decimal
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  cylinderId String?
  cylinder   Cylinder? @relation(fields: [cylinderId], references: [id], onDelete: SetNull)

  items       OrderItem[]
  review      Review?
  transaction Transaction?

  @@index([userId])
  @@index([vendorId])
}

model OrderItem {
  id       String  @id @default(uuid())
  orderId  String
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name     String
  quantity Int
  price    Decimal

  @@index([orderId])
}

model Review {
  id        String   @id @default(uuid())
  rating    Int // A numeric rating, e.g., from 1 to 5.
  comment   String? // Optional text comment from the user.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation to the User who wrote the review (the author).
  authorId String
  author   User   @relation("AuthoredReviews", fields: [authorId], references: [id], onDelete: Cascade)

  // Relation to the User who is being reviewed (the vendor).
  targetUserId String
  targetUser   User   @relation("ReceivedReviews", fields: [targetUserId], references: [id], onDelete: Cascade)

  // Each review is uniquely tied to one order.
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([targetUserId])
}
