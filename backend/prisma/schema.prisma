// GasPoint / FlameIQ Prisma schema
// Covers authentication, profile management, reminders, and support.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TxType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  REFUND
}

enum TxStatus {
  PENDING
  SUCCESS
  FAILED
}

enum Role {
  USER
  ADMIN
}

enum ProfileType {
  USER
  VENDOR
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(USER)
  address   String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  profile          Profile[]
  notifications    Notification[]
  gasPredictions   GasPrediction[]
  supportTickets   SupportTicket[]
  loginHistories   LoginHistory[]
  transactions     Transaction[]
  otpVerifications OtpVerification[]
}

model Profile {
  id           Int         @id @default(autoincrement())
  userId       Int         @unique
  user         User        @relation(fields: [userId], references: [id])
  profileType  ProfileType @default(USER)
  businessName String?
  email        String?     @unique
  phone        String?
  profilePic   String?
  address      String?
  latitude     Float?
  longitude    Float?
  isVerified   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
}

// - OTP Verification -
model OtpVerification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  codeHash  String
  purpose   String // "REGISTRATION", "LOGIN", "PASSWORD_RESET"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model GasPrediction {
  id                 Int      @id @default(autoincrement())
  userId             Int
  user               User     @relation(fields: [userId], references: [id])
  estimatedEmptyDate DateTime
  confidence         Float?
  createdAt          DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SupportTicket {
  id        Int          @id @default(autoincrement())
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  subject   String
  message   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
}

model LoginHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  ipAddress String
  userAgent String?
  createdAt DateTime @default(now())
}

model Transaction {
  id          Int      @id @default(autoincrement())
  amount      Float
  type        TxType
  status      TxStatus
  reference   String   @unique
  description String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])
  userId      Int?
}
